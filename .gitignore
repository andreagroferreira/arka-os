# Environment
.env
.env.local
*.env

# Brand deliverables (partner/internal use only, not repo content)
# Anchored to repo root so it doesn't shadow departments/brand/.
/brand/

# Private / client-specific skills (NEVER commit).
# Naming convention, so no client is ever named in a tracked file:
# put a private or client skill under _private/, or prefix it client-.
# Machine-local exceptions belong in .git/info/exclude, which is not tracked.
arka/skills/_private/
arka/skills/client-*/
arka/skills/ecosystem-*/
arka/skills/platform-arka/

# ArkaOS runtime (not in repo)
/tmp/arkaos-context-cache/

# Git worktrees
.worktrees/

# Playwright MCP verification artifacts
.playwright-mcp/
dashboard/test-results/
dashboard/playwright-report/
*.bak

# UI screenshot evidence (.arka/evidence/ui) — local only, and untracked,
# so a `git add -A` would otherwise sweep the PNGs in.
.arka/

# Session working notes
docs/.work/
